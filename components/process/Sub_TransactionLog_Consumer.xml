// Decided BEFORE the close-out: an event younger than 15 minutes whose TRANSACTION_LOG row is missing is retried
// (the START may simply not be inserted yet); an older event is processed once and then acknowledged, because
// a missing row is no longer treated as an error (a document that raised an error is never acknowledged).
for (int i = 0; i != dataContext.getDataCount(); i++) {
    InputStream is = dataContext.getStream(i)
    Properties props = dataContext.getProperties(i)
    String raw = is.getText("UTF-8")
    boolean young = true
    try {
        def ev = new JsonSlurper().parseText(raw)
        long ageMin = (System.currentTimeMillis() - java.time.Instant.parse(ev["eventTimestamp"].toString()).toEpochMilli()) / 60000L
        young = ageMin &lt; 15
    } catch (Exception e) { young = false }
    props.setProperty("document.dynamic.userdefined.EVENT_YOUNG", young ? "true" : "false")
    dataContext.storeStream(new ByteArrayInputStream(raw.getBytes("UTF-8")), props)
}
</script></dataprocessscript></step></dataprocess></configuration><dragpoints><dragpoint name="shapeAGE.dragpoint1" toShape="shapeYG" x="1232.0" y="344.0"/></dragpoints></shape><shape image="decision_icon" name="shapeYG" shapetype="decision" userlabel="Young event?" x="1248.0" y="336.0"><configuration><decision comparison="equals" name="Young event?"><decisionvalue valueType="track"><trackparameter defaultValue="" propertyId="dynamicdocument.EVENT_YOUNG" propertyName="Dynamic Document Property - EVENT_YOUNG"/></decisionvalue><decisionvalue valueType="static"><staticparameter staticproperty="true"/></decisionvalue></decision></configuration><dragpoints><dragpoint identifier="true" name="shapeYG.dragpoint1" text="True" toShape="shape5" x="1344.0" y="344.0"/><dragpoint identifier="false" name="shapeYG.dragpoint2" text="False" toShape="shape5B" x="1344.0" y="472.0"/></dragpoints></shape></shapes></process></bns:object><bns:processOverrides/></bns:Component>